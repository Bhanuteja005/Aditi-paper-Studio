# Aditi Paperie public studio details.
# Copy to .env.local for local use, or set these in the deployment environment.
# Enter only studio-confirmed values. Blank values use the honest site fallback.
# These values are public and bundled at build time. Rebuild after changing them.
# Never put passwords, API keys, or payment secrets in NEXT_PUBLIC_ variables.

NEXT_PUBLIC_STUDIO_EMAIL=
NEXT_PUBLIC_STUDIO_PHONE=
NEXT_PUBLIC_STUDIO_ADDRESS=
NEXT_PUBLIC_STUDIO_HOURS=
NEXT_PUBLIC_STUDIO_INSTAGRAM_URL=

# EMAIL: a confirmed recipient for enquiries; enables the email-app draft action.
# PHONE: the confirmed public number, including the country code.
# ADDRESS: the studio's confirmed visitor address and entrance information.
# HOURS: confirmed visiting hours or appointment arrangements.
# INSTAGRAM_URL: an HTTPS Instagram profile URL, not the Instagram homepage.
# This configuration does not create a form backend, checkout or booking system.
